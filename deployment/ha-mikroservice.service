[Unit]
Description=HA Mikroservice
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/your/cloned/repo
ExecStart=/path/to/your/cloned/repo/.venv/bin/python -m fastapi run --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/path/to/your/cloned/repo/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
